import numpy as np

rows = 3
cols = 3

value = np.zeros((rows, cols))

goal = (2, 2)

gamma = 0.9

for iteration in range(20):

    new_value = value.copy()

    for i in range(rows):
        for j in range(cols):

            if (i, j) == goal:
                continue

            rewards = []

            if i > 0:
                rewards.append(-1 + gamma * value[i - 1][j])

            if i < rows - 1:
                rewards.append(-1 + gamma * value[i + 1][j])

            if j > 0:
                rewards.append(-1 + gamma * value[i][j - 1])

            if j < cols - 1:
                rewards.append(-1 + gamma * value[i][j + 1])

            new_value[i][j] = max(rewards)

    value = new_value

print("Optimal State Values:")
print(value)

print("\nGoal State:", goal)
