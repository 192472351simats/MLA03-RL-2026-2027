import numpy as np
import tensorflow as tf
from tensorflow.keras import Sequential
from tensorflow.keras.layers import Dense

state_size = 4
action_size = 2

# Actor network
actor = Sequential([
    Dense(32, activation="relu", input_shape=(state_size,)),
    Dense(32, activation="relu"),
    Dense(action_size, activation="tanh")
])

# Critic network
critic = Sequential([
    Dense(32, activation="relu", input_shape=(state_size + action_size,)),
    Dense(32, activation="relu"),
    Dense(1)
])

state = np.random.rand(state_size)

action = actor.predict(
    state.reshape(1, -1),
    verbose=0
)

print("Game State:", state)
print("DDPG Action:", action[0])

print("Actor and Critic networks created")
