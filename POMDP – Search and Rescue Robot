import random

states = ["Safe", "Obstacle", "Victim"]

actions = ["Move", "Search", "Rescue"]

state = random.choice(states)

print("Robot observes:", state)

if state == "Safe":
    action = "Move"

elif state == "Obstacle":
    action = "Search"

else:
    action = "Rescue"

print("Robot Action:", action)

if action == "Rescue":
    reward = 20
elif action == "Search":
    reward = 5
else:
    reward = 1

print("Reward:", reward)
