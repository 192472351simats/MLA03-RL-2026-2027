import random

# Grid:
# S = Start
# F = Food
# G = Ghost

grid = [
    ["S", ".", "."],
    [".", "G", "."],
    [".", ".", "F"]
]

states = 9
actions = 4

# Q-table
Q = [[0 for j in range(actions)] for i in range(states)]

alpha = 0.1
gamma = 0.9
epsilon = 0.2

def get_state(row, col):
    return row * 3 + col

for episode in range(1000):

    row = 0
    col = 0

    for step in range(50):

        state = get_state(row, col)

        # Choose action
        if random.random() < epsilon:
            action = random.randint(0, 3)
        else:
            action = Q[state].index(max(Q[state]))

        new_row = row
        new_col = col

        if action == 0 and row > 0:
            new_row -= 1

        elif action == 1 and row < 2:
            new_row += 1

        elif action == 2 and col > 0:
            new_col -= 1

        elif action == 3 and col < 2:
            new_col += 1

        new_state = get_state(new_row, new_col)

        # Reward
        if grid[new_row][new_col] == "F":
            reward = 10
            done = True

        elif grid[new_row][new_col] == "G":
            reward = -10
            done = True

        else:
            reward = -1
            done = False

        # Q-learning update
        Q[state][action] = Q[state][action] + alpha * (
            reward + gamma * max(Q[new_state]) - Q[state][action]
        )

        row = new_row
        col = new_col

        if done:
            break

print("Training completed")

print("\nQ Table:")
for row in Q:
    print(row)
